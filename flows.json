    {
        "id": "0cc3b29095e386f5",
        "type": "function",
        "z": "f88d1ae351fa23a2",
        "name": "function 2",
        "func": "const data = msg.payload;\n\n// Déterminer la commande automatique\nlet commande = \"OFF\";\n\nif (Number(data.co2) > 800 || Number(data.temperature) > 26) {\n    commande = \"ON\";\n}\n\n// Sortie 1 : commande de ventilation\n// Sortie 2 : température\n// Sortie 3 : humidité\n// Sortie 4 : CO2\n\nreturn [\n    {\n        topic: \"smartenv/salle2/ventilation\",\n        payload: commande\n    },\n    {\n        payload: Number(data.temperature)\n    },\n    {\n        payload: Number(data.humidite)\n    },\n    {\n        payload: Number(data.co2)\n    }\n];\n",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 640,
