    {
        "id": "6acf0076321c130f",
        "type": "function",
        "z": "f88d1ae351fa23a2",
        "name": "function 1",
        "func": "const data = (typeof msg.payload === \"string\") ? JSON.parse(msg.payload) : msg.payload;\nconst modeAuto = flow.get(\"auto_salle1\") ?? true; // Automatique par défaut\n\nlet msgVentilation = null;\n\nif (modeAuto) {\n    let commande = (data.co2 > 800 || data.temperature > 26) ? \"ON\" : \"OFF\";\n    msgVentilation = { topic: \"smartenv/salle1/ventilation\", payload: commande };\n}\n\nreturn [\n    msgVentilation,                // Sortie 1 : ignorée si Mode Automatique est OFF\n    { payload: data.temperature }, // Sortie 2 : Jauge Température\n    { payload: data.humidite },    // Sortie 3 : Jauge Humidité\n    { payload: data.co2 }          // Sortie 4 : Jauge CO2\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 500,
        "wires": [
            [
                "0974c0b3b766acbb",
                "baf946ed2d7750eb"
            ],
            [
                "4f8bf5236b1f516e"
            ],
