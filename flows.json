        "name": "function 3",
        "func": "const data = msg.payload\nlet commande = \"OFF\";\nif (data.co2 > 800 || data.temperature > 26) {\n    msg.payload = \"ON\";\n} \nreturn[\n    {topic : \"smart/salle3/ventilation\", payload : commande},\n    {payload: data.temperature} , \n    {payload : data.humidite},\n    {payload : data.co2}\n];\n",
